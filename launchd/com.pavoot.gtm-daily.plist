<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily GTM run at 08:30: prospect, plan, draft (runs at next wake if the Mac was asleep).
     Install: cp launchd/com.pavoot.gtm-daily.plist ~/Library/LaunchAgents/ &&
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pavoot.gtm-daily.plist
     Test now: launchctl kickstart gui/$(id -u)/com.pavoot.gtm-daily -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.pavoot.gtm-daily</string>
    <key>ProgramArguments</key>
    <array><string>/Users/ana/Documents/CODEBASE/pavoot-gtm/bin/daily.sh</string></array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/Users/ana/.nvm/versions/node/v24.14.0/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <!-- Mailboxes outreach comes from. Use "ana" until Gohar has connected hers (DM the bot: connect google gohar@pavoot.com). -->
        <key>GTM_SENDERS</key><string>ana,gohar</string>
        <!-- New people per day. -->
        <key>GTM_DAILY_NEW</key><string>20</string>
    </dict>
    <key>StandardErrorPath</key><string>/tmp/pavoot-gtm-daily.err</string>
</dict>
</plist>
